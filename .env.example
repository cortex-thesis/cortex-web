# Copy this file to .env and replace the placeholders with values from
# Supabase Dashboard > Project Settings > Database > Connection string.
# The transaction pooler URI is recommended for hosted/serverless deployments.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Keep hosted PostgreSQL connections warm to avoid a connection handshake on every page.
DATABASE_CONN_MAX_AGE=120
DATABASE_CONN_HEALTH_CHECKS=true
# Local Supabase (use DB_SSLMODE=require for hosted Supabase):
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=54322
DB_SSLMODE=disable
DB_SEARCH_PATH=public

# Generate a unique value before deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set true to run the hardcoded UI without connecting to Supabase.
CORTEX_TEMPLATE_ONLY=false
# Development only. This defaults to false whenever DJANGO_DEBUG=false.
CORTEX_ENABLE_DEMO_ACCOUNTS=true

# School-approved retention values. Schedule `manage.py enforce_retention --apply`
# only after these values and backup-expiry requirements have been approved.
EEG_RAW_RETENTION_DAYS=30
EEG_PROCESSED_RETENTION_DAYS=90
ARCHIVED_MEDIA_RETENTION_DAYS=30

# Private Supabase Storage through its S3-compatible server-side endpoint.
# Enable S3 in Supabase Dashboard > Storage > Configuration and create keys.
SUPABASE_STORAGE_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ACCESS_KEY=replace-with-storage-access-key
SUPABASE_STORAGE_SECRET_KEY=replace-with-storage-secret-key
SUPABASE_STORAGE_BUCKET=private-content
SUPABASE_STORAGE_REGION=REGION

# Local EEG signal/model storage. Database fields contain relative object keys only.
EEG_DATA_ROOT=local-data
EEG_RAW_SUBDIR=raw
EEG_PROCESSED_SUBDIR=processed
EEG_MODEL_SUBDIR=models
EEG_TEMP_SUBDIR=temp
