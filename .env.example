# Copy this file to .env and replace the placeholders with values from
# Supabase Dashboard > Project Settings > Database > Connection string.
# The transaction pooler URI is recommended for hosted/serverless deployments.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Generate a unique value before deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set true to run the hardcoded UI without connecting to Supabase.
CORTEX_TEMPLATE_ONLY=false

# Private Supabase Storage through its S3-compatible server-side endpoint.
# Enable S3 in Supabase Dashboard > Storage > Configuration and create keys.
SUPABASE_STORAGE_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ACCESS_KEY=replace-with-storage-access-key
SUPABASE_STORAGE_SECRET_KEY=replace-with-storage-secret-key
SUPABASE_STORAGE_BUCKET=private-content
SUPABASE_STORAGE_REGION=REGION
